{
  "name": "react-generic-tools",
  "version": "0.0.139",
  "description": "Generic utility types, methods and components.",
  "keywords": [
    "utility",
    "generic",
    "react"
  ],
  "homepage": "https://tsickert.com/react-generic-tools",
  "bugs": {
    "email": "info@tsickert.com",
    "url": "https://github.com/thaibault/react-generic-tools/issues"
  },
  "license": "CC-BY-4.0",
  "author": {
    "email": "info@tsickert.com",
    "name": "Torben Sickert",
    "url": "https://tsickert.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaibault/react-generic-tools.git"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./debugHelper": "./dist/debugHelper.js",
    "./debugHelper.js": "./dist/debugHelper.js",
    "./endToEndTestHelper": "./dist/endToEndTestHelper.js",
    "./endToEndTestHelper.js": "./dist/endToEndTestHelper.js",
    "./testHelper": "./dist/testHelper.js",
    "./testHelper.js": "./dist/testHelper.js",
    "./type": "./dist/type.d.ts"
  },
  "main": "dist/index.js",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "yarn build:types && yarn build:plain",
    "build:plain": "weboptimizer build",
    "build:types": "weboptimizer build:types",
    "check": "yarn check:types && yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "echo No tests available.",
    "test:browser": "weboptimizer test:browser",
    "test:coverage": "weboptimizer test:coverage",
    "test:coverage:report": "weboptimizer test:coverage:report",
    "update:documentation": "web-documentation",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "clientnode": "^4.0.1531",
    "core-js": "^3.51.0",
    "eslint": "^10.14.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "jest": "^30.5.2",
    "jsdoc": "^4.0.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tslib": "^2.9.1",
    "typescript-eslint": "^8.72.1",
    "web-documentation": "^1.0.74",
    "weboptimizer": "^4.0.109",
    "webpack-dev-server": "^6.1.0"
  },
  "peerDependencies": {
    "@babel/preset-react": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "clientnode": "*",
    "core-js": "*",
    "react": "*",
    "react-dom": "*",
    "tslib": "*"
  },
  "peerDependenciesMeta": {
    "@babel/preset-react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "clientnode": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "resolutions": {
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webDocumentation": {
    "languages": [
      "enUS",
      "deDE",
      "frFR"
    ],
    "tagline": "Generic react utilities."
  },
  "webOptimizer": {
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "generic": {
      "entry": {
        "debugHelper": "./debugHelper",
        "endToEndTestHelper": "./endToEndTestHelper",
        "index": "./index.ts",
        "testHelper": "./testHelper",
        "type": "./type"
      },
      "supportedBrowsers": [
        "IE >= 11",
        "last 2 versions",
        "> 5%"
      ]
    },
    "module": {
      "optimizer": {
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      },
      "preprocessor": {
        "javaScript": {
          "options": {
            "overrides": {
              "__evaluate__": "[{test: /\\.(jsx|tsx)$/u, presets: [['@babel/preset-react', {development: self.debug}]]}]"
            },
            "presets": {
              "#": "NOTE: We disable module export/import transformation to allow tree shaking by the final (minimizer).",
              "__evaluate__": "[['@babel/preset-env', {targets: self.generic.isWeb ? {browsers: self.generic.supportedBrowsers, node: packageConfiguration.engines.node.replace(/>?=?([0-9]+)/, '$1')} : {node: packageConfiguration.engines.node.replace(/>?=?([0-9]+)/, '$1')}}], '@babel/preset-typescript']"
            }
          }
        }
      }
    },
    "path": {
      "source": {
        "base": "src/"
      },
      "target": {
        "base": "dist/"
      }
    }
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
